# Production Environment Variables for alignhealthcare.ai

# Backend API URLs - Update these with your production API URLs
NEXT_PUBLIC_API_URL=https://api.alignhealthcare.ai
PYTHON_API_URL=https://api.alignhealthcare.ai
NODE_API_URL=https://api.alignhealthcare.ai
NEXT_PUBLIC_APP_URL=https://alignhealthcare.ai

# Database - Use your production MongoDB
# MONGODB_URI=your-production-mongodb-uri

# Sentry (optional)
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# Auth
# SESSION_SECRET=your-production-secret-key

