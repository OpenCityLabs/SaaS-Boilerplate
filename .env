# AlignHealthcare.ai - Environment Configuration
# This file contains public/non-sensitive environment variables

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Backend API URLs (Public - used by browser)
NEXT_PUBLIC_API_URL=http://localhost:8082

# Database Configuration (Public - connection details)
# Note: These are localhost defaults for development
# For production, override in .env.local or deployment environment
FALKORDB_PORT=6380
REDIS_PORT=6381

######## [BEGIN] SENSITIVE DATA ########
# For security reasons, don't update the following variables directly in this file.
# Please create a new file named `.env.local` (already created)
# All environment files ending with `.local` won't be tracked by Git.
